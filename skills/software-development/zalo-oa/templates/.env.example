# Zalo OA Bot - Cấu hình
# Copy file này thành .env và điền giá trị thật

# ===== ZALO OA =====
# Lấy từ developers.zalo.me > App > Cài đặt
ZALO_APP_ID=
# App Secret — chuỗi dài KHÁC App ID (nút "Copy secret key" trong Cài đặt)
ZALO_APP_SECRET=
# OA Secret Key = chính App Secret Key (Zalo chỉ có 1 key/app)
ZALO_OA_SECRET_KEY=
# Access Token đại diện OA (từ tools/explorer/<APP_ID>), hạn ~90 ngày
ZALO_ACCESS_TOKEN=

# ===== AI =====
# OmniRoute gateway local
OMNIROUTE_URL=http://localhost:20128/v1
AI_MODEL=cmd/deepseek/deepseek-v4-flash

# ===== SERVER =====
PORT=4810
# Token bảo vệ endpoint test /api/test-send (tự chọn)
WEBHOOK_TEST_TOKEN=

# ===== PROMPT =====
AI_SYSTEM_PROMPT=Bạn là trợ lý ảo của một Official Account Zalo. Trả lời ngắn gọn, tự nhiên, thân thiện bằng tiếng Việt. Nếu không biết câu trả lời, hãy nói rõ và đề nghị liên hệ hỗ trợ.
